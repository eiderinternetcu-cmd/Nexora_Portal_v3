# .env.staging.example — template for REAL staging. Copy to .env.staging and fill.
# NEVER commit .env.staging (gitignored). Placeholders only here — no real secrets.

# ── App ─────────────────────────────────────────────────────────────────────
# APP_ENV is the environment switch the app reads. Only APP_ENV=production
# closes the API schema (/docs, /redoc, /openapi.json → 404); with `staging`
# they stay reachable, which is intentional for a non-public environment — put
# them behind HTTP auth at the edge if staging is exposed.
APP_ENV=staging
DEBUG=false
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS_STAGING

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
CLIENT_ACCESS_TOKEN_EXPIRE_HOURS=24
CLIENT_REFRESH_TOKEN_EXPIRE_DAYS=90

# ── PostgreSQL (staging) — container hostnames for docker-compose.staging.yml ─
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexora_staging
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_STAGING_DB_PASSWORD

# ── Redis (staging) ─────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Security / rate limit ───────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=100000          # high during smoke tests; lower later

# ── Browser CORS ─────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser WITH credentials. Comma-
# separated absolute origins (scheme://host[:port]), matched exactly.
# The player is normally served same-origin (nginx proxies /api/), so no
# preflight happens; this list only matters when a frontend lives on a
# DIFFERENT origin, where a missing entry looks like an unexplained login
# failure. UNSET keeps the historical default (localhost:5173/4173,
# 127.0.0.1:5173/4173, 172.27.99.151:5173).
# NEVER use "*": wildcard + credentials is invalid per the CORS spec.
CORS_ALLOW_ORIGINS=https://staging.nexoraplay.net,http://localhost:5173,http://127.0.0.1:5173

# ── IPTV / playback ─────────────────────────────────────────────────────────
HEARTBEAT_TTL_SECONDS=180
PLAYBACK_TOKEN_EXPIRE_SECONDS=60
STREAM_AUTH_CACHE_TTL_SECONDS=180

# ── P0 flags — INITIAL state OFF (activate gradually per the runbook) ────────
ENTITLEMENT_ENFORCE=false
JWT_REQUIRE_AUD=false
SIGNED_URL_ENFORCE=false
PLAYBACK_IP_BINDING_MODE=off          # off | soft | strict

# ── STB ─────────────────────────────────────────────────────────────────────
STB_PORTAL_URL=https://staging.nexoraplay.net/nexora_portal

# ── Flussonic/Astra nodes — SAME-ORIGIN bases (so playback_url passes the gate)
# Credentials are READ-ONLY and live ONLY here. Leave blank in this example.
# ec-main (Esmeraldas Astra origin 181.78.246.211:8002)
FLUSSONIC_BASE_URL=https://staging.nexoraplay.net/stream/ec-main
FLUSSONIC_READONLY_USER=
FLUSSONIC_READONLY_PASSWORD=
FLUSSONIC_READONLY=true
# co-main (Colombia origin 38.210.187.13:8002)
FLUSSONIC_CO_MAIN_BASE_URL=https://staging.nexoraplay.net/stream/co-main
FLUSSONIC_CO_MAIN_USER=
FLUSSONIC_CO_MAIN_PASSWORD=
# ec-quito (Quito Astra origin 45.70.202.171:8002) — use the ROTATED credential
FLUSSONIC_EC_QUITO_BASE_URL=https://staging.nexoraplay.net/stream/ec-quito
FLUSSONIC_EC_QUITO_USER=
FLUSSONIC_EC_QUITO_PASSWORD=

# Public same-origin bases used by the M3U importer (keeps source_url same-origin)
FLUSSONIC_PUBLIC_EC_MAIN_BASE_URL=https://staging.nexoraplay.net/stream/ec-main
FLUSSONIC_PUBLIC_CO_MAIN_BASE_URL=https://staging.nexoraplay.net/stream/co-main

# Import mode for channel source_url (relative = same-origin everywhere)
CHANNEL_SOURCE_URL_MODE=relative

# ── Multi-domain playback ────────────────────────────────────────────────────
# The player is served from several domains, so playback_url takes its ORIGIN
# from the request (Host / X-Forwarded-Host + X-Forwarded-Proto) and keeps the
# PATH configured in the FLUSSONIC_*_BASE_URL above. Example: base
# https://staging.nexoraplay.net/stream/ec-main with Host tv.staging.example →
# https://tv.staging.example/stream/ec-main/<stream>/index.m3u8
#
# SECURITY: Host is client-controlled, so ONLY the hostnames listed here can
# ever appear in a playback_url; any other Host falls back to the fixed
# FLUSSONIC_*_BASE_URL. Comma-separated, case-insensitive, a port is allowed
# ("host:8443"). Empty (default) = feature off, playback_url stays exactly as
# it is today. Every host listed here needs its own Nginx server block with the
# same auth-gated /stream/<node>/ locations (see deploy/nginx/nexoraplay.conf).
PLAYBACK_HOST_ALLOWLIST=staging.nexoraplay.net
