# Copy this file to .env.production on the server and fill real secrets.

APP_NAME=NexoraAPI
# APP_ENV=production is the environment switch the app reads. Besides being
# informational, it CLOSES the API schema: /docs, /redoc and /openapi.json
# return 404 (they stay open in development and staging). Do not change it here
# unless you intend to publish the full API map — including the internal
# stream-auth contract — to the Internet and to raw-IP callers.
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Redis connection pool (stress F2) ────────────────────────────────────────
# Bounds are set here, NOT inherited from the library. requirements.txt pins
# `redis[asyncio]>=5.2.0` and the default is not stable across versions: 7.4.0
# is effectively unbounded, 8.1.0 caps at 100. The deployed image landed on
# 8.1.0, so the API silently acquired a 100-op ceiling nobody chose — and the
# plain pool does not queue: past the ceiling it raises MaxConnectionsError and
# the request 500s (measured: errors == concurrency - 100, exactly).
#
# The realistic trigger is not cruise traffic, it is the RECONNECT STAMPEDE
# after a Redis restart or a network blip — every player reconnecting at once,
# which is exactly when the API must not be handing out 500s.
#
# REDIS_MAX_CONNECTIONS is PER WORKER: multiply by the uvicorn worker count and
# keep the total below Redis's `maxclients` (default 10000). 200 is far more
# parallelism than one worker can drive (each op is sub-millisecond); it exists
# to absorb the burst, not steady state.
REDIS_MAX_CONNECTIONS=200
# > 0 → the op WAITS this long for a free connection (blocking pool): a burst
#       becomes a few ms of latency instead of errors. Bounded and not infinite
#       on purpose — an unbounded wait would let a stuck Redis hang every worker
#       silently instead of surfacing.
# <= 0 → fail fast with MaxConnectionsError (the old behavior, still bounded).
REDIS_POOL_TIMEOUT_SECONDS=5.0

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# ── Admin login lockout (NX-AUTH) ────────────────────────────────────────────
# Brute-force brake on /api/v1/auth/login and /api/admin/auth/login, keyed by
# the attempted USERNAME.
#
# Why not by IP: RateLimitMiddleware already caps the login path at 10 req/min
# per IP, and that IP comes from X-Forwarded-For — a header the client controls.
# An IP-keyed lockout is therefore evadable by rotating the header AND abusable:
# spoofing a colleague's address would lock them out of the admin panel. Behind
# CGNAT it also punishes every subscriber sharing the address. The username is
# the axis the attacker must commit to, so that is the one we count.
#
# LOGIN_LOCKOUT_ENABLED=false (default) keeps production EXACTLY as it runs
# today: the legacy username+IP counters, answering 423 with the remaining TTL.
# Deploying this branch without touching the variable changes no behavior.
#
# Set it to true to switch on the hardened policy:
#   - counted per username, LOGIN_LOCKOUT_MAX_ATTEMPTS consecutive failures
#     inside LOGIN_LOCKOUT_WINDOW_SECONDS arm a block of
#     LOGIN_LOCKOUT_DURATION_SECONDS;
#   - a blocked attempt answers the SAME 401 "Invalid credentials" as a wrong
#     password — no 423, no 429, no "try again in Ns". A distinct status would
#     confirm the account exists in a lockable state and tell the attacker when
#     to resume; the counter also arms for usernames that do not exist, so the
#     response never separates a real account from a made-up one;
#   - a successful login resets the counter;
#   - an operator locked out of their own account sees only "Invalid
#     credentials" — that is the intended trade. Diagnose it from the audit
#     trail (`auth.login_blocked`), not from the HTTP response.
#
# Redis namespaces are disjoint between the two modes
# (nexora:lockout:{user} legacy vs nexora:lockout:admin:{user} hardened), so the
# flag can be flipped either way without inheriting a stale counter.
LOGIN_LOCKOUT_ENABLED=false
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

# ── Client IP resolution (NX-AUTH) ───────────────────────────────────────────
# Where "the caller's IP" comes from. It feeds the login lockout, the per-IP
# rate limiter, the audit trail and the playback token's IP binding.
#
# The historical implementation read the FIRST value of X-Forwarded-For — a
# header the caller writes. That makes every per-IP control:
#   · EVADABLE — a different fake address per request, no bucket ever fills, so
#     the 10 req/min cap on the login path never fires;
#   · ABUSABLE — send a colleague's address with a few wrong passwords and the
#     legacy lockout blocks THEM out of the admin panel for LOGIN_LOCKOUT_MINUTES;
#   · WRONG BEHIND CGNAT — one shared exit address punishes every subscriber
#     behind it.
#
# CLIENT_IP_SOURCE=legacy (default) keeps that behavior byte for byte, so
# deploying this branch changes nothing until the variable is set.
#
# CLIENT_IP_SOURCE=edge honors a forwarded header ONLY when the TCP peer is
# listed in TRUSTED_PROXY_CIDRS, in this order:
#   1. X-Real-IP        — what deploy/nginx/snippets/proxy-common.conf sets from
#                         $remote_addr;
#   2. the LAST hop of X-Forwarded-For — a forwarded chain grows to the RIGHT, so
#      the rightmost entry is the one the closest trusted proxy wrote; everything
#      to its left is unverified caller input;
#   3. the peer address, if the proxy asserted nothing usable.
# From an untrusted peer no header is honored at all — spoofing buys nothing.
#
# TRUSTED_PROXY_CIDRS must list the address the API sees the EDGE arrive from,
# not the public IP of the server: with nginx and the api in the same compose
# network that is the Docker bridge subnet. Check it before flipping the flag:
#
#   docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}' nexora_nginx
#
# and enter the containing subnet (e.g. 172.18.0.0/16). Getting this WRONG fails
# safe, not open: an unlisted proxy means every request is attributed to the
# proxy's own address, so all clients share one rate-limit bucket — visible
# immediately as spurious 429s, and fixed by correcting the value.
# Empty = nothing is trusted (which is the right value with no proxy in front).
#
# If a CDN is ever put in front of nginx, add its published ranges here too and
# make nginx set $remote_addr from the CDN's header (set_real_ip_from /
# real_ip_header / real_ip_recursive) — see deploy/nginx/snippets/proxy-common.conf.
CLIENT_IP_SOURCE=legacy
TRUSTED_PROXY_CIDRS=

# ── Playback node binding + node allowlist (NX-NODE) ─────────────────────────
# The /stream/* gate binds a playback token to its stream_key AND its Flussonic
# node, but the two checks were not symmetric: a missing 'sk' claim was refused
# while a missing 'node' claim passed on EVERY node. With four nodes in the
# system that is a real cross-node replay primitive, currently latent only
# because all 41 channels have a node assigned.
#
# PLAYBACK_NODE_BINDING_ENFORCE=false (default) keeps the tolerance. Setting it
# to true checks the node exactly like the stream key.
#
# Migration note before flipping it: every issuing path in the API sets 'sk' and
# 'node' together or neither, and a token with neither is ALREADY refused by the
# stream_key check — so this is expected to be a no-op. Verify it stays that way
# by confirming no channel has a NULL/empty flussonic_node:
#
#   SELECT count(*) FROM channels WHERE flussonic_node IS NULL OR flussonic_node = '';
#
# Playback tokens live PLAYBACK_TOKEN_EXPIRE_SECONDS (60s), so a rollback takes
# full effect within a minute.
PLAYBACK_NODE_BINDING_ENFORCE=false
#
# PLAYBACK_NODE_ALLOWLIST: the node is a PATH SEGMENT of the incoming
# /stream/<node>/<stream_key>/… URL — caller input, and nothing in app/ ever
# checked it. Listing the real node ids rejects an unknown one BEFORE the token
# is decoded, keeping it out of token evaluation and out of the Redis grant
# keyspace. Empty (default) = no validation.
# It must be a SUPERSET of every node that has a location in nginx and every
# distinct channels.flussonic_node, or those channels stop playing:
#
#   SELECT DISTINCT flussonic_node FROM channels WHERE is_active;
#
# PLAYBACK_NODE_ALLOWLIST=ec-main,co-main,ec-quito
PLAYBACK_NODE_ALLOWLIST=

# ── Browser CORS ─────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser WITH credentials. Comma-
# separated absolute origins (scheme://host[:port]), matched exactly.
# Today the player is served from the SAME origin as the API (nginx proxies
# /api/), so no preflight happens and this list is not exercised. It becomes
# load-bearing the moment a frontend is deployed on a DIFFERENT origin: a
# missing entry then surfaces as a login that fails with no clear hint.
# UNSET keeps the historical default (localhost:5173/4173, 127.0.0.1:5173/4173,
# 172.27.99.151:5173) — i.e. exactly today's behavior.
# NEVER use "*": wildcard + credentials is invalid per the CORS spec and
# browsers reject the response.
CORS_ALLOW_ORIGINS=https://nexoraplay.net,https://tvdigital.laredtelco.com

HEARTBEAT_TTL_SECONDS=180
PLAYBACK_TOKEN_EXPIRE_SECONDS=60
CLIENT_ACCESS_TOKEN_EXPIRE_HOURS=24
CLIENT_REFRESH_TOKEN_EXPIRE_DAYS=90

STB_PORTAL_URL=https://nexoraplay.net/nexora_portal

FLUSSONIC_BASE_URL=https://nexoraplay.net/stream/ec-main
FLUSSONIC_READONLY_USER=
FLUSSONIC_READONLY_PASSWORD=
FLUSSONIC_READONLY=true

FLUSSONIC_CO_MAIN_BASE_URL=https://nexoraplay.net/stream/co-main
FLUSSONIC_CO_MAIN_USER=
FLUSSONIC_CO_MAIN_PASSWORD=

# ec-quito (Quito Astra origin 45.70.202.171:8002). Same-origin base; needs an
# Nginx location /stream/ec-quito/ proxying to the origin. Secrets go in .env only.
FLUSSONIC_EC_QUITO_BASE_URL=https://nexoraplay.net/stream/ec-quito
FLUSSONIC_EC_QUITO_USER=
FLUSSONIC_EC_QUITO_PASSWORD=

FLUSSONIC_PUBLIC_EC_MAIN_BASE_URL=https://nexoraplay.net/stream/ec-main
FLUSSONIC_PUBLIC_CO_MAIN_BASE_URL=https://nexoraplay.net/stream/co-main

# ── Multi-domain playback ────────────────────────────────────────────────────
# The player is served from several domains, so playback_url takes its ORIGIN
# from the request (Host / X-Forwarded-Host + X-Forwarded-Proto) and keeps the
# PATH configured in the FLUSSONIC_*_BASE_URL above. Example: base
# https://nexoraplay.net/stream/ec-main with Host tvdigital.laredtelco.com →
# https://tvdigital.laredtelco.com/stream/ec-main/<stream>/index.m3u8
#
# SECURITY: Host is client-controlled, so ONLY the hostnames listed here can
# ever appear in a playback_url; any other Host falls back to the fixed
# FLUSSONIC_*_BASE_URL. Comma-separated, case-insensitive, a port is allowed
# ("host:8443"). Empty (default) = feature off, playback_url stays exactly as
# it is today. Every host listed here needs its own Nginx server block with the
# same auth-gated /stream/<node>/ locations (see deploy/nginx/nexoraplay.conf).
PLAYBACK_HOST_ALLOWLIST=nexoraplay.net,tvdigital.laredtelco.com

# ── Node health probe (P0.5) ─────────────────────────────────────────────────
# The `api` container has NO route to the Flussonic origins (181.78.246.211:8002,
# 38.210.187.13:8002 → timeout / HTTP 000); only Nginx does, which is why
# playback works while the management-API health check calls every node down and
# the alerting fills with false "node down".
#   origin      = the legacy probe (management API, from the backend). Honest
#                 only where the backend can route to the origin — NOT here.
#   hls_signed  = mint a playback token with the same issuer the /stream/* gate
#                 validates and ask the EDGE for a signed HLS manifest
#                 (<edge>/stream/<node>/<stream>/index.m3u8?token=…), expecting
#                 2xx. One end-to-end signal covering gate + node + stream; it
#                 reports no stream_count, since there is no management API call.
#                 The probe leaves NOTHING behind: its token is revoked as soon
#                 as the probe ends, and it is marked (claim 'pb') so the gate
#                 seeds NO segment grant for it — otherwise every monitoring
#                 cycle would open tokenless segment access for the backend's own
#                 IP, the exact latency STREAM_GRANT_MAX_LIFETIME_SECONDS bounds.
# Default "origin" = today's behavior byte for byte, so deploying this changes
# nothing until the flag is flipped. Rollback: remove the line + recreate `api`.
NODE_PROBE_MODE=origin

# The edge as seen FROM the api container (Docker service name on nexora_net) —
# not the public domain: the probe must not leave the host to come back in.
NODE_PROBE_EDGE_BASE_URL=http://nexora_nginx
NODE_PROBE_TIMEOUT_SECONDS=8

# Optional pin, CSV of "node_id:stream_key" (e.g. "ec-main:tvn,co-main:caracol").
# Empty (default) = the probe uses the lowest-numbered ACTIVE channel of each
# node from the catalog, so it follows the catalog instead of a second list that
# rots silently. Pin only when one specific stream is the agreed canary — a
# pinned stream that dies on its own then reads as the whole node being down.
NODE_PROBE_STREAMS=

# ── Node failover (P2.2 / NX-FLU) ────────────────────────────────────────────
# co-main (38.210.187.13) is DOWN and its 4 channels have no service. This is
# what serves them from another node — but only after someone states two facts
# the backend cannot work out on its own.
#
# FACT 1 — which other node carries the stream. It is NOT discoverable here:
# `channels.flussonic_node` is one scalar per channel (the schema cannot express
# "this stream also lives on node B"), and the only authority on what a node
# serves is the node's own management API, which the `api` container cannot
# reach — the very reason NODE_PROBE_MODE exists. Asking the EDGE instead
# (<edge>/stream/<node>/<stream>/index.m3u8) would mean a network round-trip and
# a minted token per candidate INSIDE /authorize, and its 404 is ambiguous
# (missing Nginx location vs stream absent vs node down). So it is declared:
#   FLUSSONIC_STREAM_MIRRORS = CSV of "stream_key:node[|node…]", preference order.
# Empty (default) = no stream has a mirror = the failover can never fire, which
# is the correct state until the mirrors actually exist on the target node.
#
# FACT 2 — when a node counts as down. Taken from the alert the existing monitor
# keeps open (app/main.py::_stream_health_monitor → AlertService), so the
# failover and /admin/alerts can never disagree, at the cost of the monitor's
# 2-minute granularity. Its HONESTY is NODE_PROBE_MODE's: with the default
# `origin` probe the backend reaches no origin and calls EVERY node down.
#
#   off    (default) = today byte for byte; no health is read at all.
#   mirror           = swap a down node for the first HEALTHY declared mirror;
#                      no healthy candidate → keep the original node. Safe to
#                      enable even while NODE_PROBE_MODE=origin lies, because
#                      the worst case is exactly `off`.
#   strict           = same, but no healthy candidate → 503 NODE_UNAVAILABLE.
#                      Do NOT enable this until NODE_PROBE_MODE=hls_signed, or
#                      every channel is refused.
#
# The resolved node feeds BOTH the token's `node` claim and the /stream/<node>/
# path of the playback_url, resolved ONCE per request before the token is minted
# — so a failover always issues a NEW token bound to the NEW node. Reusing the
# old token across nodes is the cross-node reuse PLAYBACK_NODE_BINDING_ENFORCE
# exists to refuse. Rollback: remove the line + recreate `api`; playback tokens
# live 60s, so it takes effect within a minute.
FLUSSONIC_FAILOVER_MODE=off
# Example once co-main's 4 streams are mirrored on ec-main:
# FLUSSONIC_STREAM_MIRRORS=caracol:ec-main,rcn:ec-main,canal1:ec-main,citytv:ec-main
FLUSSONIC_STREAM_MIRRORS=

# Used by scripts/provision_nexoraplay_production.sh.
LETSENCRYPT_EMAIL=admin@nexoraplay.net
