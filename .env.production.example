# Copy this file to .env.production on the server and fill real secrets.

APP_NAME=NexoraAPI
# APP_ENV=production is the environment switch the app reads. Besides being
# informational, it CLOSES the API schema: /docs, /redoc and /openapi.json
# return 404 (they stay open in development and staging). Do not change it here
# unless you intend to publish the full API map — including the internal
# stream-auth contract — to the Internet and to raw-IP callers.
APP_ENV=production
DEBUG=false
SECRET_KEY=CHANGE_ME_64_RANDOM_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# ── Admin login lockout (NX-AUTH) ────────────────────────────────────────────
# Brute-force brake on /api/v1/auth/login and /api/admin/auth/login, keyed by
# the attempted USERNAME.
#
# Why not by IP: RateLimitMiddleware already caps the login path at 10 req/min
# per IP, and that IP comes from X-Forwarded-For — a header the client controls.
# An IP-keyed lockout is therefore evadable by rotating the header AND abusable:
# spoofing a colleague's address would lock them out of the admin panel. Behind
# CGNAT it also punishes every subscriber sharing the address. The username is
# the axis the attacker must commit to, so that is the one we count.
#
# LOGIN_LOCKOUT_ENABLED=false (default) keeps production EXACTLY as it runs
# today: the legacy username+IP counters, answering 423 with the remaining TTL.
# Deploying this branch without touching the variable changes no behavior.
#
# Set it to true to switch on the hardened policy:
#   - counted per username, LOGIN_LOCKOUT_MAX_ATTEMPTS consecutive failures
#     inside LOGIN_LOCKOUT_WINDOW_SECONDS arm a block of
#     LOGIN_LOCKOUT_DURATION_SECONDS;
#   - a blocked attempt answers the SAME 401 "Invalid credentials" as a wrong
#     password — no 423, no 429, no "try again in Ns". A distinct status would
#     confirm the account exists in a lockable state and tell the attacker when
#     to resume; the counter also arms for usernames that do not exist, so the
#     response never separates a real account from a made-up one;
#   - a successful login resets the counter;
#   - an operator locked out of their own account sees only "Invalid
#     credentials" — that is the intended trade. Diagnose it from the audit
#     trail (`auth.login_blocked`), not from the HTTP response.
#
# Redis namespaces are disjoint between the two modes
# (nexora:lockout:{user} legacy vs nexora:lockout:admin:{user} hardened), so the
# flag can be flipped either way without inheriting a stale counter.
LOGIN_LOCKOUT_ENABLED=false
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

# ── Browser CORS ─────────────────────────────────────────────────────────────
# Origins allowed to call the API from a browser WITH credentials. Comma-
# separated absolute origins (scheme://host[:port]), matched exactly.
# Today the player is served from the SAME origin as the API (nginx proxies
# /api/), so no preflight happens and this list is not exercised. It becomes
# load-bearing the moment a frontend is deployed on a DIFFERENT origin: a
# missing entry then surfaces as a login that fails with no clear hint.
# UNSET keeps the historical default (localhost:5173/4173, 127.0.0.1:5173/4173,
# 172.27.99.151:5173) — i.e. exactly today's behavior.
# NEVER use "*": wildcard + credentials is invalid per the CORS spec and
# browsers reject the response.
CORS_ALLOW_ORIGINS=https://nexoraplay.net,https://tvdigital.laredtelco.com

HEARTBEAT_TTL_SECONDS=180
PLAYBACK_TOKEN_EXPIRE_SECONDS=60
CLIENT_ACCESS_TOKEN_EXPIRE_HOURS=24
CLIENT_REFRESH_TOKEN_EXPIRE_DAYS=90

STB_PORTAL_URL=https://nexoraplay.net/nexora_portal

FLUSSONIC_BASE_URL=https://nexoraplay.net/stream/ec-main
FLUSSONIC_READONLY_USER=
FLUSSONIC_READONLY_PASSWORD=
FLUSSONIC_READONLY=true

FLUSSONIC_CO_MAIN_BASE_URL=https://nexoraplay.net/stream/co-main
FLUSSONIC_CO_MAIN_USER=
FLUSSONIC_CO_MAIN_PASSWORD=

# ec-quito (Quito Astra origin 45.70.202.171:8002). Same-origin base; needs an
# Nginx location /stream/ec-quito/ proxying to the origin. Secrets go in .env only.
FLUSSONIC_EC_QUITO_BASE_URL=https://nexoraplay.net/stream/ec-quito
FLUSSONIC_EC_QUITO_USER=
FLUSSONIC_EC_QUITO_PASSWORD=

FLUSSONIC_PUBLIC_EC_MAIN_BASE_URL=https://nexoraplay.net/stream/ec-main
FLUSSONIC_PUBLIC_CO_MAIN_BASE_URL=https://nexoraplay.net/stream/co-main

# ── Multi-domain playback ────────────────────────────────────────────────────
# The player is served from several domains, so playback_url takes its ORIGIN
# from the request (Host / X-Forwarded-Host + X-Forwarded-Proto) and keeps the
# PATH configured in the FLUSSONIC_*_BASE_URL above. Example: base
# https://nexoraplay.net/stream/ec-main with Host tvdigital.laredtelco.com →
# https://tvdigital.laredtelco.com/stream/ec-main/<stream>/index.m3u8
#
# SECURITY: Host is client-controlled, so ONLY the hostnames listed here can
# ever appear in a playback_url; any other Host falls back to the fixed
# FLUSSONIC_*_BASE_URL. Comma-separated, case-insensitive, a port is allowed
# ("host:8443"). Empty (default) = feature off, playback_url stays exactly as
# it is today. Every host listed here needs its own Nginx server block with the
# same auth-gated /stream/<node>/ locations (see deploy/nginx/nexoraplay.conf).
PLAYBACK_HOST_ALLOWLIST=nexoraplay.net,tvdigital.laredtelco.com

# ── Node health probe (P0.5) ─────────────────────────────────────────────────
# The `api` container has NO route to the Flussonic origins (181.78.246.211:8002,
# 38.210.187.13:8002 → timeout / HTTP 000); only Nginx does, which is why
# playback works while the management-API health check calls every node down and
# the alerting fills with false "node down".
#   origin      = the legacy probe (management API, from the backend). Honest
#                 only where the backend can route to the origin — NOT here.
#   hls_signed  = mint a playback token with the same issuer the /stream/* gate
#                 validates and ask the EDGE for a signed HLS manifest
#                 (<edge>/stream/<node>/<stream>/index.m3u8?token=…), expecting
#                 2xx. One end-to-end signal covering gate + node + stream; it
#                 reports no stream_count, since there is no management API call.
#                 The probe leaves NOTHING behind: its token is revoked as soon
#                 as the probe ends, and it is marked (claim 'pb') so the gate
#                 seeds NO segment grant for it — otherwise every monitoring
#                 cycle would open tokenless segment access for the backend's own
#                 IP, the exact latency STREAM_GRANT_MAX_LIFETIME_SECONDS bounds.
# Default "origin" = today's behavior byte for byte, so deploying this changes
# nothing until the flag is flipped. Rollback: remove the line + recreate `api`.
NODE_PROBE_MODE=origin

# The edge as seen FROM the api container (Docker service name on nexora_net) —
# not the public domain: the probe must not leave the host to come back in.
NODE_PROBE_EDGE_BASE_URL=http://nexora_nginx
NODE_PROBE_TIMEOUT_SECONDS=8

# Optional pin, CSV of "node_id:stream_key" (e.g. "ec-main:tvn,co-main:caracol").
# Empty (default) = the probe uses the lowest-numbered ACTIVE channel of each
# node from the catalog, so it follows the catalog instead of a second list that
# rots silently. Pin only when one specific stream is the agreed canary — a
# pinned stream that dies on its own then reads as the whole node being down.
NODE_PROBE_STREAMS=

# Used by scripts/provision_nexoraplay_production.sh.
LETSENCRYPT_EMAIL=admin@nexoraplay.net
