# Todas opcionales. Sin ellas el panel usa window.location.origin + /api/admin,
# que es lo correcto tanto en dev (proxy de Vite) como en produccion (nginx).

# Origen absoluto de la API. Solo si el panel se sirve desde otro host.
# VITE_ADMIN_API_BASE_URL=https://api.ejemplo.com

# Prefijo de la superficie admin. /api/v1 es el alias legacy y NO tiene
# sessions, channels, metrics ni audit. No lo cambies sin motivo.
# VITE_ADMIN_API_PREFIX=/api/admin

# VITE_ADMIN_APP_VERSION=admin-panel-0.1.0

# Segundos de margen para refrescar el access token antes de que caduque.
# VITE_ADMIN_TOKEN_REFRESH_SKEW_SECONDS=120
