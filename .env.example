# Nexora API — Environment Variables
# Copiar este archivo a .env y completar los valores

APP_NAME=NexoraAPI
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_64_random_chars_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_secret
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Redis pool, per API worker. Set explicitly because redis-py's default is not a
# constant across versions (7.4.0 = unbounded, 8.1.0 = 100) and the plain pool
# RAISES instead of queueing, so a reconnect stampede becomes a wall of 500s.
# REDIS_POOL_TIMEOUT_SECONDS > 0 → wait for a free connection (blocking pool);
# <= 0 → fail fast with MaxConnectionsError (still bounded).
REDIS_MAX_CONNECTIONS=200
REDIS_POOL_TIMEOUT_SECONDS=5.0
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=60

# Admin login lockout (NX-AUTH). OFF = legacy behavior (username+IP counters,
# 423). ON = per-username lockout that answers the same 401 as a wrong password.
LOGIN_LOCKOUT_ENABLED=false
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_DURATION_SECONDS=900

# Client IP resolution (NX-AUTH). "legacy" = the historical read of the FIRST
# X-Forwarded-For value, i.e. a header the caller writes. "edge" = only a proxy
# listed in TRUSTED_PROXY_CIDRS may assert a client IP (X-Real-IP, then the LAST
# X-Forwarded-For hop); from any other peer the headers are ignored and the
# connection address is used. Locally there is no proxy in front, so leaving
# TRUSTED_PROXY_CIDRS empty is correct — "edge" then simply uses 127.0.0.1.
CLIENT_IP_SOURCE=legacy
TRUSTED_PROXY_CIDRS=

# Playback node binding (NX-NODE). false = legacy, a playback token with NO
# 'node' claim is accepted on any node. true = the node is checked exactly like
# the stream key. Empty PLAYBACK_NODE_ALLOWLIST = no validation of the node in
# the /stream/<node>/... path; set it to the real node ids to reject the rest
# before the token is evaluated.
PLAYBACK_NODE_BINDING_ENFORCE=false
PLAYBACK_NODE_ALLOWLIST=

# Parental control (NX-PARENTAL). false = today: the catalog carries no
# `censored` key and playback never asks for a PIN. true = a channel marked
# channels.censored needs a server-verified PIN before a playback token is
# minted; a household with NO PIN configured is blocked, not allowed, so set
# PINs (PUT /api/client/parental/pin works with the flag off) BEFORE flipping.
# The unlock TTL slides while the channel is being watched. The attempt limiter
# is what protects a 4-6 digit secret — the hash alone does not.
PARENTAL_CONTROL_ENFORCE=false
PARENTAL_PIN_UNLOCK_TTL_SECONDS=900
PARENTAL_PIN_MAX_ATTEMPTS=5
PARENTAL_PIN_ATTEMPT_WINDOW_SECONDS=900
PARENTAL_PIN_LOCKOUT_SECONDS=900

HEARTBEAT_TTL_SECONDS=180
STB_PORTAL_URL=http://172.27.99.151/nexora_portal

# Node health probe (P0.5). "origin" = legacy, ask each node's management API
# from the backend. "hls_signed" = mint a playback token and ask the EDGE for a
# signed HLS manifest (the only route the api container actually has to a node).
NODE_PROBE_MODE=origin
NODE_PROBE_EDGE_BASE_URL=http://nexora_nginx
NODE_PROBE_TIMEOUT_SECONDS=8
# Optional "node:stream_key" CSV pin; empty = use the node's first active channel.
NODE_PROBE_STREAMS=

# Node failover (P2.2 / NX-FLU). "off" = legacy, the channel's node is always
# used. "mirror" = a node the monitor reports DOWN is swapped for the first
# healthy node declared below as a mirror of that stream; with no healthy
# candidate the original node is kept, so it is never worse than "off".
# "strict" = same, but with no healthy candidate it answers 503 NODE_UNAVAILABLE
# instead of a URL to a dead node — enable it only with NODE_PROBE_MODE=hls_signed,
# since the legacy "origin" probe reports every node down.
FLUSSONIC_FAILOVER_MODE=off
# WHICH other node carries a stream cannot be discovered: channels.flussonic_node
# holds one node per channel, and only the node itself knows what it serves —
# which the api container cannot ask (see NODE_PROBE_MODE). So it is declared:
# CSV of "stream_key:node[|node]" in preference order, e.g.
# "caracol:ec-main,rcn:ec-main|ec-quito". Empty = no stream has a mirror = the
# failover can never fire.
FLUSSONIC_STREAM_MIRRORS=